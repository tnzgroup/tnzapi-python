# Copy this file to .env and fill in your values.
# .env should not be committed to source control.

TNZ_AUTH_TOKEN=your_auth_token_here

# Optional: override the API base URL (e.g. to point at a staging environment)
# Defaults to https://api.tnz.co.nz/api/v3.00 if not set. Must be https:// —
# see TNZ_ALLOW_INSECURE_HTTP below if you genuinely need plain http://.
# TNZ_API_URL=https://api.tnz.co.nz/api/v3.00

# Optional, local development only — allows TNZ_API_URL to use plain http://
# instead of https://. Never set this outside local development: it disables
# the guard that stops your bearer token from being sent unencrypted.
# TNZ_ALLOW_INSECURE_HTTP=true
