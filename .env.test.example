# .env.test.example
#
# Copy this file to .env.test and fill in your values.
# .env.test is gitignored — never commit real credentials or IDs.
#
# Loading order (later files win): .env -> .env.local -> .env.test
# .env.test is loaded last, so it can override .env.local for integration-style
# runs — e.g. pointing at a different account/environment than your normal
# local dev setup.
#
# Note: unit tests (tests/) mock the HTTP layer and don't read these fixture
# values. tests/integration/ is what reads them, and it's opt-in only - see
# TNZ_RUN_LIVE_TESTS below and README.md's "Integration tests" section.

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

TNZ_AUTH_TOKEN=your_auth_token_here

# Required to run tests/integration/ at all (`pytest -m integration`) - having
# a real TNZ_AUTH_TOKEN configured is not by itself enough confirmation that
# firing real, possibly billable requests is intended right now. Left commented
# out deliberately - uncomment only once you mean to run live tests, since a
# plain copy-and-fill-in-the-token of this file must NOT enable them by default.
# TNZ_RUN_LIVE_TESTS=1

# Required in addition to TNZ_RUN_LIVE_TESTS to run the Workflow send test
# specifically - Workflow has no Mode="Test"-equivalent safety switch, so this
# is a separate, explicit confirmation that TNZ_TEST_WORKFLOW_TEMPLATE_ID
# below points at a template that's safe to trigger repeatedly. Also left
# commented out by default for the same reason as TNZ_RUN_LIVE_TESTS above.
# TNZ_ALLOW_WORKFLOW_SEND=1

# Optional: override the API base URL (e.g. to point at a staging environment)
# TNZ_API_URL=https://api.tnz.co.nz/api/v3.00

# Optional, local development only — allows TNZ_API_URL to use plain http://
# instead of https://. Never set this outside local development.
# TNZ_ALLOW_INSECURE_HTTP=true

# ---------------------------------------------------------------------------
# Messaging — recipient fixtures
# Real numbers/addresses used by integration tests that actually send messages.
# Keep these to accounts/numbers you own or have permission to test with.
# ---------------------------------------------------------------------------

# Mobile number for SMS / TTS / Voice / WhatsApp / RCS tests (E.164 format)
TNZ_TEST_MOBILE=+64211111111

# Fax number for Fax tests (E.164 format)
TNZ_TEST_FAX=+6491111111

# Email address for Email tests
TNZ_TEST_EMAIL=test@example.com

# Workflow template UUID for Workflow tests
TNZ_TEST_WORKFLOW_TEMPLATE_ID=00000000-0000-0000-0000-000000000000

# WhatsApp requires an account-approved TemplateID and a registered sender
# FromNumber - both are required fields the SDK validates client-side, so the
# WhatsApp send test cannot run without real values here.
TNZ_TEST_WHATSAPP_TEMPLATE_ID=00000000-0000-0000-0000-000000000000
TNZ_TEST_WHATSAPP_FROM_NUMBER=+64211111111

# ---------------------------------------------------------------------------
# Reports / Actions — message fixture
# A real MessageID that exists in your account (already sent).
# Used by Reports.Status, Reports.SMSReply, Actions.Abort, etc.
# ---------------------------------------------------------------------------

TNZ_TEST_MESSAGE_ID=ID123456

# Channel the above MessageID belongs to (sms | email | fax | tts | voice)
TNZ_TEST_MESSAGE_CHANNEL=sms
